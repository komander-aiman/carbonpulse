# Copy to .env.local and fill in. Values below are the demo defaults.

# Signed household session cookie. Must be at least 16 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set to "false" to make adapters attempt live sources. Demo mode makes zero
# external calls and renders every route from seeded data.
DEMO_MODE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MapLibre style. OpenFreeMap is keyless and permits commercial use with attribution.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Cron entry points require this bearer token.
CRON_SECRET=

# Pilot admin stub. Not a substitute for a real server-side role check.
ADMIN_STUB=false

# Supabase persistence. The publishable key is reserved for future browser
# auth; database reads and writes currently happen server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
